<div id="topBar">
    <div id="titleSection">
        <h1>Government Contracts and Bidding</h1>
        <h2>{{title}}</h2>
    </div>

    <div id="loginBar">
        {{#if vendorLoggedIn}}
        <a href="/vendorLogout">VENDOR LOGOUT</a>
        {{else if adminLoggedIn}}
        <a href="/adminLogout">ADMIN LOGOUT</a>
        {{else}}
        <a href="/vendorLogin">Vendor Login</a>
        <a href="/adminLogin">Admin Login</a>
        {{/if}}
    </div>

    <div id="navBar">
        {{#if onMainPage}}
            {{#if vendorLoggedIn}}
            <a href="/openBids">Place a Bid</a>
            <a href="/yourBids">View Your Bids</a>
            <a href="/awardedContracts">Awarded Contracts</a>
            {{else if adminLoggedIn}}
            <a href="/questions">Questions</a>
            <a href="/analytics">Analytics</a>
            <a href="/biddingPortal">Bidding Portal</a>
            <a href="/awardedContracts">Awarded Contracts</a>
            {{else}}
            <a href="/awardedContracts">Awarded Contracts</a>
            {{/if}}
        {{else}}
        <a href="/main">RETURN TO MAIN PAGE</a>
        {{/if}}
    </div>
</div>