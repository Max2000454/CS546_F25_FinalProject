<div id="error">
    {{#if error}}
    <p>{{error}}</p>
    {{/if}}
</div>

{{#each contracts}}
<div class="contract">
    <div class="contractHead">
        <h1>{{contractName}}</h1>
    </div>
    <div class="contractBody">
        <div class="awardee">
            <h2>Awardee</h2>
            <p>{{vendorName}}</p>
        </div>
        <div class="publicStats">
            <h2>Public Stats</h2>
            <p>Amount: {{bidAmount}}</p>
        </div>
        <div class="description">
            <h2>Status</h2>
            <p>{{status}}</p>
        </div>
    </div>
</div>
{{/each}}
