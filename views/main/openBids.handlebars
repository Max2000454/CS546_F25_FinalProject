<div id="error">
    {{#if error}}
    <p>{{error}}</p>
    {{/if}}
</div>

<div class="filterButtonContainer">
    <input type="text" id="filterInput" placeholder="Filter contracts">
    <button id="filterButton">Select Filters</button>
</div>

{{#each contracts}}
<div class="contract" data-title="{{title}}" data-description="{{description}}">
    <div class="contractHead">
        <h1>{{title}}</h1>
    </div>

    <div class="contractBody">
        <div class="contractInfo">
            <h2>Information</h2>
            <p>Current Highest Bid: {{highestBid}}</p>
            <p>Expires on: {{due_date}}</p>
        </div>

        <div class="contractDesc">
            <h2>Description</h2>
            <p>{{description}}</p>
        </div>

        <div class="contractImage">
            {{#if imgSrc}}
                <img src="{{imgSrc}}" alt="contract image">
            {{else}}
                <p class="noImage">No image available</p>
            {{/if}}
        </div>

        <div class="placeButton">
            <form action="/submitBid/{{title}}" method="GET">
                <button type="submit">Place Bid</button>
            </form>
        </div>
    </div>
</div>
{{/each}}

<script src="/script/openBids.js"></script>
