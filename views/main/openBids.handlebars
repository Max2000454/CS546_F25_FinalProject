<div id="error">
    {{#if error}}
    <p>{{error}}</p>
    {{/if}}
</div>

<div class="filterButtonContainer">
    <button>Select Filters</button>
</div>

{{#each contracts}}
<div class="contract">
    <div class="contractHead">
        <h1>{{name}}</h1>
    </div>
    <div class="contractBody">
        <div class="contractInfo">
            <h2>Information</h2>
            <p>Current Highest Bid: {{highestBid}}</p>
            <p>Expires on: {{expirationDate}}</p>
        </div>
        <div class="contractDesc">
            <h2>Description</h2>
            <p>{{description}}</p>
        </div>
        <div class="contractImage">
            <img src="{{imgSrc}}" alt="no image available">
        </div>
        <div class="placeButton">
            <form action="/submitBid/{{name}}" method="GET">
                <button type="submit">Place Bid</button>
            </form>
        </div>
    </div>
</div>
{{/each}}
