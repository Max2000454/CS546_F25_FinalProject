<div id="error">
    {{#if error}}
    <p>{{error}}</p>
    {{/if}}
</div>

{{#each contracts}}
<div class="contract">
    <div class="contractHead">
        <h1>{{title}}</h1>
    </div>

    <div class="contractBody">
        <div class="contractInfo">
            <h2>Information</h2>
            <p>Current Best Bid: {{highestBid}}</p>
            <p>Expires on: {{due_date}}</p>
            <p>Your Bid: {{amount}}</p>
        </div>

        <div class="contractStatus">
            <h2>Status</h2>
            <p>{{status}}</p>
        </div>

        {{#if ongoing}}
        <div class="cancelButton">
            <form action="/withdrawBid" method="POST">
                <input type="hidden" name="contractName" value="{{title}}">
                <button type="submit">Cancel Bid</button>
            </form>
        </div>

        <div class="placeButton">
            <form action="/submitBid/{{title}}" method="GET">
                <button type="submit">Place New Bid</button>
            </form>
        </div>
        {{/if}}
    </div>
</div>
{{/each}}
