<div id="error">
    {{#if error}}
    <p>{{error}}</p>
    {{/if}}
</div>

{{#each contracts}}
<div class="contract">
    <div class="contractHead">
        <h1>{{name}}</h1>
    </div>
    <div class="contractBody">
        <div class="contractInfo">
            <h2>Information</h2>
            <p>Current Highest Bid: {{highestBid}}</p>
            <p>Expires on: {{expirationDate}}</p>
            <p>Your Bid: {{yourBid}}</p>
        </div>
        <div class="contractStatus">
            <h2>Status</h2>
            <p>{{status}}</p>
        </div>
        {{#if ongoing}}
        <div class="cancelButton">
            <button>Cancel Bid</button>
        </div>
        <div class="placeButton">
            <button>Place Bid</button>
        </div>
        {{/if}}
    </div>
</div>
{{/each}}