<div id="error">
    {{#if error}}
    <p>{{error}}</p>
    {{/if}}
</div>

<div id="login">
    <div id="loginHead">
        <h2>Admin Login</h2>
    </div>
    <div id="loginBody">
        <form action="/adminLogin" method="POST" id="loginForm">
            <div id="usernameContainer">
                <label for="username" id="usernameLabel">Username</label>
                <input type="text" id="username" name="username" placeholder="Enter username here">
            </div>
            <div id="passwordContainer">
                <label for="password" id="passwordLabel">Password</label>
                <input type="password" id="password" name="password" placeholder="Enter password here">
            </div>
            <div id="buttonContainer">
                <input type="submit" id="loginButton" name="loginButton">
            </div>
        </form>
    </div>
</div>

<script src="/script/adminLogin.js"></script>