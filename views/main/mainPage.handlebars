<div id="error">
    {{#if error}}
    <p>{{error}}</p>
    {{/if}}
</div>

<div id="heroSection">
    <h1>America’s First Government Contract Bidding Platform</h1>
    <p>
        A centralized platform where government agencies publish requests,
        vendors submit proposals, and the public can view awarded contracts
        with full transparency.
    </p>
</div>

<div id="infoSection">
    <h2>Who Is This Platform For?</h2>
    <p>
        Vendors can browse open bids, submit proposals, and manage their bids.
        Government administrators can review submissions, award contracts,
        and analyze bidding activity. Members of the public can view awarded
        contracts to ensure transparency.
    </p>
</div>

<div id="actionGrid">
    <div class="actionCard">
        <h3>Public Access</h3>
        <p>Browse contracts that have already been awarded by government agencies.</p>
        <a class="actionButton" href="/awardedContracts">View Awarded Contracts</a>
    </div>

    <div class="actionCard">
        <h3>Vendors</h3>
        <p>Log in to view open bids, submit proposals, and manage your bids.</p>
        <a class="actionButton" href="/vendorLogin">Vendor Login</a>
    </div>

    <div class="actionCard">
        <h3>Government Admins</h3>
        <p>Manage bids, review proposals, award contracts, and view analytics.</p>
        <a class="actionButton" href="/adminLogin">Admin Login</a>
    </div>

    <div class="actionCard">
        <h3>Questions or Concerns</h3>
        <p>Submit questions or concerns regarding the platform.</p>
        <a class="actionButton" href="/feedback">Submit Form</a>
    </div>
</div>
